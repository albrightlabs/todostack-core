# ======================================
# TodoStack Configuration
# ======================================
# Copy this file to .env and customize
# All settings have sensible defaults
# ======================================

# --------------------------------------
# Site Identity
# --------------------------------------
# Site name appears in the header and browser title
SITE_NAME="TodoStack"

# Short tagline (reserved for future use)
SITE_TAGLINE="Simple, fast task management"

# Emoji displayed when no logo is set (shown before site name)
SITE_EMOJI=""

# Base URL for generating absolute URLs (optional)
# Example: https://tasks.example.com
SITE_URL=""

# --------------------------------------
# Branding - Images
# --------------------------------------
# Path to logo image (PNG, SVG, or WebP recommended)
# Height will be constrained to 24px for optimal header sizing
# Example: /assets/my-logo.png
LOGO_URL=""

# Logo width constraint (CSS value, e.g., "120" or "120px")
LOGO_WIDTH="120"

# Custom favicon path (PNG recommended, 32x32px or larger)
# Example: /assets/favicon.png
FAVICON_URL=""

# Custom emoji for favicon (overrides SITE_EMOJI for favicon only)
FAVICON_EMOJI=""

# Custom letter overlay on favicon (defaults to first letter of SITE_NAME)
FAVICON_LETTER=""

# Show letter overlay on favicon (true/false)
FAVICON_SHOW_LETTER=true

# --------------------------------------
# Branding - Header Link
# --------------------------------------
# Optional external link displayed in header (e.g., link to main website)
EXTERNAL_LINK_NAME=""
EXTERNAL_LINK_URL=""
EXTERNAL_LINK_LOGO=""

# --------------------------------------
# Branding - Footer
# --------------------------------------
# Footer text (supports HTML)
# Example: "&copy; 2025 My Company. All rights reserved."
FOOTER_TEXT=""

# Show "Powered by TodoStack" link in footer
FOOTER_SHOW_POWERED_BY=true

# --------------------------------------
# Branding - Colors
# --------------------------------------
# Primary brand color (used for buttons, links, accents)
# Default is a pleasant blue
COLOR_PRIMARY="#3b82f6"

# Primary color hover state
COLOR_PRIMARY_HOVER="#2563eb"

# --------------------------------------
# Security - Authentication
# --------------------------------------
# Super admin email (required for initial setup)
# This email has permanent admin access and cannot be deleted
SUPER_ADMIN_EMAIL="admin@example.com"

# Super admin password hash
# Generate with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
# Example hash for password "admin123" (DO NOT USE IN PRODUCTION):
# SUPER_ADMIN_PASSWORD_HASH="$2y$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi"
SUPER_ADMIN_PASSWORD_HASH=""

# --------------------------------------
# Security - Session & Rate Limiting
# --------------------------------------
# These values are currently hardcoded but documented here for reference
# Future versions may make these configurable

# Session lifetime in seconds (default: 7200 = 2 hours)
# SESSION_LIFETIME=7200

# Maximum failed login attempts before lockout (default: 5)
# MAX_LOGIN_ATTEMPTS=5

# Lockout duration in seconds after max attempts (default: 900 = 15 minutes)
# LOCKOUT_DURATION=900

# --------------------------------------
# Features
# --------------------------------------
# Enable dark mode support (auto-detects system preference)
FEATURE_DARK_MODE=true

# Enable keyboard shortcuts (Enter to add, Escape to close, Ctrl+S to save)
# FEATURE_KEYBOARD_SHORTCUTS=true

# Enable drag and drop reordering
# FEATURE_DRAG_DROP=true

# --------------------------------------
# Data Storage
# --------------------------------------
# Path to data directory (relative to project root or absolute)
# Default: data
# DATA_PATH="data"

# --------------------------------------
# Advanced
# --------------------------------------
# Enable debug mode (shows detailed errors - NEVER use in production)
# DEBUG=false

# Timezone for date/time operations
# Example: America/New_York, Europe/London, Asia/Tokyo
# TIMEZONE="UTC"
